      canWrite = false; pending = {};
      setStatus(code === "revoked" ? "Saving stopped because access to this page changed. Reload to continue." : "You can read this brief but not change it.");
    } else if (code === "unavailable" && !retried[id]) {
      retried[id] = 1; setStatus("Saving…");
      setTimeout(function () { held[id] = false; flush(id); }, 800 + Math.random() * 1200);
    } else if (code === "quota_exceeded") setStatus("This page's storage is full, so the change wasn't saved.");
    else setStatus("Couldn't save. Your change is still here; edit again or reload to retry.");
  }
  function resolveNames() {
    if (!user) return;
    var ids = [];
    Object.keys(server).forEach(function (k) { var b = server[k] && server[k].by; if (typeof b === "string" && ids.indexOf(b) < 0) ids.push(b); });
    if (roundDoc && typeof roundDoc.by === "string" && ids.indexOf(roundDoc.by) < 0) ids.push(roundDoc.by);
    ids = ids.filter(function (i) { return !(i in names); });
    if (!ids.length) return;
    user.profiles(ids).then(function (ps) { ids.forEach(function (i) { names[i] = (ps && ps[i] && ps[i].name) || ""; }); ITEMS.forEach(paintRow); }, function () {});
  }

  // ---- Events ----
  $("filter").addEventListener("click", function (e) {
    var b = e.target.closest("button[data-f]"); if (!b) return;
    filter = b.getAttribute("data-f");
    Array.prototype.forEach.call(this.querySelectorAll("button"), function (x) { x.setAttribute("aria-pressed", String(x === b)); });
    applyFilter();
  });
  document.addEventListener("click", function (e) {
    var b = e.target.closest(".seg button[data-v]");
    if (!b || b.disabled) return;
    var host = b.closest("[data-id]"); if (!host) return;
    var id = host.getAttribute("data-id"), v = b.getAttribute("data-v");
    queue(id, { status: statusOf(id) === v ? null : v }, 0);
    paint();
  });
  document.addEventListener("input", function (e) {
    var t = e.target;
    if (!t.matches || !t.matches("textarea[id^='note-']") || t.readOnly) return;
    queue(t.id.slice(5), { note: t.value.slice(0, NOTE_MAX) }, NOTE_DEBOUNCE_MS);
  });
  document.addEventListener("focusout", function (e) {
    var t = e.target;
    if (!t.matches || !t.matches("textarea[id^='note-']")) return;
    var id = t.id.slice(5);
    if (pending[id]) flush(id);
    setTimeout(function () { if (byId[id]) paintRow(byId[id]); }, 0);
  });
  $("done-btn").addEventListener("click", function () {
    if (!writable() || roundBusy) return;
    Object.keys(pending).forEach(flush);
    var next = !(roundDoc && roundDoc.done === true);
    var body = { done: next, at: new Date().toISOString(), by: myId || null };
    roundBusy = true; paintTally();
    var ref = db.collection("rounds").doc(D.round_id);
    (roundDoc ? ref.update(body) : ref.set(body)).then(function () {
      roundDoc = Object.assign({}, roundDoc || {}, body); setStatus(next ? "Marked done. Claude acts on its next check, or tell it in Crow." : "Reopened");
    }, function () { setStatus("Couldn't mark the brief done. Tell Claude in the Crow session instead."); }).then(function () { roundBusy = false; paintTally(); });
  });

  paint();

  // ---- Connect to the artifact runtime ----
  (async function connect() {
    var c = window.claude;
    if (!c || typeof c.use !== "function") { $("tally").textContent = "Decisions load when this page is opened on claude.ai."; return; }
    var got = await Promise.all([c.use("user").catch(function () { return null; }), c.use("db").catch(function () { return null; })]);
    user = got[0];
    if (user) {
      try { myId = await user.id(); } catch (e) { myId = null; }
      try { canWrite = await user.can("data.write"); } catch (e) { canWrite = null; }
    }
    if (!got[1]) { $("tally").textContent = "Sign in on claude.ai to see and save decisions."; return; }
    db = got[1];
    db.collection("decisions").onSnapshot(function (snap) {
      var next = {};
      snap.docs.forEach(function (d) { if (!d.exists) return; var b = d.data(); if (b && typeof b === "object") next[d.id] = b; });
      server = next; ready = true; paint(); resolveNames();
    }, function (e) {
      if (e && e.code === "revoked") canWrite = false;
      setStatus("Live updates stopped. Reload to see new decisions."); paint();
    });
    db.collection("rounds").doc(D.round_id).onSnapshot(function (d) {
      roundDoc = d && d.exists ? d.data() : null; paintTally(); resolveNames();
    }, function () {});
    if (canWrite === false) setStatus("You can read this brief but not change it.");
  })();
})();
</script>
