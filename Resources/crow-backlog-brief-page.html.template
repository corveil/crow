    if (!typing) { var n = str(d.note); if (r.ta.value !== n) r.ta.value = n; }
  }

  function paintTally() {
    if (!db || !ready) return;
    var c = { go: 0, later: 0, drop: 0, none: 0 };
    CARDS.forEach(function (it) { c[statusOf(it.id) || "none"]++; });
    $("tally").className = "";
    $("tally").innerHTML = "<b class='num'>" + c.go + "</b> kick off · <b class='num'>" + c.later + "</b> deprioritize · <b class='num'>" + c.drop + "</b> close · <b class='num'>" + c.none + "</b> undecided";
    var done = !!(roundDoc && roundDoc.done === true);
    var b = $("done-btn");
    b.disabled = !writable() || roundBusy;
    b.setAttribute("aria-pressed", String(done));
    b.textContent = done ? "Marked done · Claude acts on the next check" : "I'm done with this brief";
  }

  function applyFilter() {
    var any = false;
    SECTIONS.forEach(function (s) {
      var sec = $("s-" + s), shown = 0;
      CARDS.forEach(function (it) {
        if (it.section !== s) return;
        var r = rows[it.id]; if (!r) return;
        var st = statusOf(it.id);
        var show = filter === "all" || (filter === "undecided" ? !st : st === filter);
        r.el.hidden = !show; if (show) shown++;
      });
      if (CARDS.some(function (it) { return it.section === s; })) sec.hidden = !shown;
      if (shown) any = true;
    });
    $("empty").hidden = CARDS.length ? any : false;
  }

  function paint() { ITEMS.forEach(paintRow); paintTally(); applyFilter(); }

  function queue(id, patch, delay) {
    if (!writable()) return;
    held[id] = false;
    pending[id] = Object.assign(pending[id] || {}, patch);
    if (timers[id]) { clearTimeout(timers[id]); timers[id] = null; }
    if (delay > 0) timers[id] = setTimeout(function () { timers[id] = null; flush(id); }, delay); else flush(id);
  }
  function fullBody(id, patch) { return Object.assign({ status: null, note: "", by: null, at: null, ticket: null, result: null }, server[id] || {}, written[id] || {}, patch); }
  // An existing doc is merged with update(), so fields this view never
  // touched (the `ticket` and `result` Claude writes back) survive a viewer's edit.
  function write(id, patch) {
    var ref = db.collection("decisions").doc(id);
    if (!server[id]) return ref.set(fullBody(id, patch));
