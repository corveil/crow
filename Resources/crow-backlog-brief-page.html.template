    h += u ? "<a class='key' href='" + esc(u) + "' target='_blank' rel='noopener'>" + esc(it.key) + " ↗</a>" : "<span class='key'>" + esc(it.key) + "</span>";
    if (str(it.repo) && str(it.key).indexOf(it.repo) < 0) h += "<span>" + esc(it.repo) + "</span>";
