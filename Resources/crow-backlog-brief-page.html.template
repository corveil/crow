      [["if_wrong", "If it's wrong"], ["undo", "Undo"], ["notice", "We'd notice"]].forEach(function (k) { if (str(rk[k[0]])) h += "<dt>" + k[1] + "</dt><dd>" + md(rk[k[0]]) + "</dd>"; });
