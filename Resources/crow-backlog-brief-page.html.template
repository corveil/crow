      var u = safeUrl(r.url);
      return "<tr><td class='k'>" + (u ? "<a href='" + esc(u) + "' target='_blank' rel='noopener'>" + esc(r.key) + "</a>" : esc(r.key)) + "</td><td>" + md(r.title) + "</td><td class='muted'>" + md(r.why) + "</td></tr>";
    }).join("") + "</tbody>";
