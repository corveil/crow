    }).join("");
    $("band").hidden = false;
  }

  // Burndown: stacked areas per repo on one y scale, with the total as a line.
  (function burn() {
    var B = D.burndown; if (!B || !arr(B.days).length || !arr(B.order).length) return;
    var repos = B.order, colors = ["var(--s1)", "var(--s2)", "var(--s3)", "var(--s4)"];
    var n = B.days.length, W = 640, H = 220, L = 40, R = 14, T = 12, Bt = 26;
    var tot = B.days.map(function (_, i) { return repos.reduce(function (a, r) { return a + ((B.series[r] || [])[i] || 0); }, 0); });
    var max = Math.max.apply(null, tot.concat([1])), step = max > 400 ? 200 : max > 200 ? 100 : max > 80 ? 50 : max > 40 ? 20 : 10, top = Math.ceil(max / step) * step;
    function x(i) { return n > 1 ? L + (W - L - R) * i / (n - 1) : L; }
    function y(v) { return T + (H - T - Bt) * (1 - v / top); }
    var s = "<svg viewBox='0 0 " + W + " " + H + "' role='img' aria-label='Open issues over the last " + n + " days, stacked by repository, ending at " + tot[n - 1] + "'>";
    for (var g = 0; g <= top; g += step) s += "<line x1='" + L + "' x2='" + (W - R) + "' y1='" + y(g) + "' y2='" + y(g) + "' stroke='var(--rule)' stroke-width='1'/><text x='" + (L - 6) + "' y='" + (y(g) + 4) + "' text-anchor='end' font-size='11' fill='var(--muted)' font-family='IBM Plex Mono, monospace'>" + g + "</text>";
    var base = B.days.map(function () { return 0; });
    repos.forEach(function (r, ri) {
      var upper = base.map(function (b, i) { return b + ((B.series[r] || [])[i] || 0); });
      var pts = upper.map(function (v, i) { return x(i) + "," + y(v); }).join(" ");
      var back = base.map(function (v, i) { return x(i) + "," + y(v); }).reverse().join(" ");
      s += "<polygon points='" + pts + " " + back + "' fill='" + colors[ri % 4] + "' fill-opacity='" + (ri === 0 ? 0.85 : 0.75) + "' stroke='none'/>";
      base = upper;
    });
    s += "<polyline points='" + tot.map(function (v, i) { return x(i) + "," + y(v); }).join(" ") + "' fill='none' stroke='var(--ink)' stroke-width='1.5'/>";
    s += "<circle cx='" + x(n - 1) + "' cy='" + y(tot[n - 1]) + "' r='4' fill='var(--ink)'/>";
    s += "<text x='" + (x(n - 1) - 8) + "' y='" + (y(tot[n - 1]) - 8) + "' text-anchor='end' font-size='12' font-weight='600' fill='var(--ink)' font-family='IBM Plex Mono, monospace'>" + tot[n - 1] + " open</text>";
    [0, Math.floor((n - 1) / 2), n - 1].forEach(function (i) {
      s += "<text x='" + x(i) + "' y='" + (H - 6) + "' text-anchor='" + (i === 0 ? "start" : i === n - 1 ? "end" : "middle") + "' font-size='11' fill='var(--muted)' font-family='IBM Plex Mono, monospace'>" + esc(fmtDay(B.days[i])) + "</text>";
    });
    s += "</svg>";
    $("burn-lbl").textContent = "Open issues, last " + n + " days";
    $("burn").innerHTML = s;
    $("burn-legend").innerHTML = repos.map(function (r, ri) { return "<span><i style='background:" + colors[ri % 4] + "'></i>" + esc(r) + " <span class='mono'>" + ((B.series[r] || [])[n - 1] || 0) + "</span></span>"; }).join("");
    $("chart").hidden = false; $("band").hidden = false;
  })();
  if ($("chart").hidden) $("band").className = "band single";

  (function comp() {
    var C = arr(S.composition); if (!C.length) return;
