      C.map(function (c, i) { return "<span style='width:" + (100 * (c.n || 0) / total) + "%;background:" + cols[i % 4] + "'></span>"; }).join("") + "</div><div class='legend'>" +
      C.map(function (c, i) { return "<span><i style='background:" + cols[i % 4] + "'></i>" + esc(c.label) + " <span class='mono'>" + esc(c.n) + "</span></span>"; }).join("") + "</div>";
    $("chart").hidden = false; $("band").className = "band";
