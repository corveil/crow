<title>__BRIEF_TITLE__</title>
<!--
  /crow-backlog-brief page template (CROW-1367). `brief.sh build` fills the
  title and the #brief-data block from brief.json. Never edit a built page by
  hand: change the cards, compose and build again. Decisions are not in this
  file; they live in the artifact's db: `decisions/<card id>` (one doc per
  card, ids carry the round id) and `rounds/<round_id>` ({done}).
-->
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans+Condensed:wght@500;600;700&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap">
<style>
/* Layout: one 1120px column. A header band with the round's numbers and the open-issue burndown, then decision cards (reasoning left, decision rail right) grouped by section, then what is in flight, held, and earlier rounds. */
:root {
  --bg: #F3F5F8;
  --surface: #FFFFFF;
  --sunk: #E9EDF3;
  --ink: #18202D;
  --muted: #5A6476;
  --rule: #D8DEE7;
  --accent: #2C4FB8;
  --accent-soft: #E3E9F9;
  --go: #17794F;
  --go-soft: #DDF1E7;
  --later: #9A6410;
  --later-soft: #F7EBD3;
  --drop: #A63A35;
  --drop-soft: #F6E0DE;
  --s1: #2C4FB8;
  --s2: #2E8F87;
  --s3: #B5792A;
  --s4: #8A55B8;
  --f-display: "IBM Plex Sans Condensed", "Arial Narrow", "Roboto Condensed", system-ui, sans-serif;
  --f-body: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --f-mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #10141B; --surface: #171C25; --sunk: #1E2430; --ink: #E5E9F0; --muted: #98A2B3; --rule: #2A3242;
    --accent: #8FA6FF; --accent-soft: #232D4A;
    --go: #5CC995; --go-soft: #173327; --later: #E2B15E; --later-soft: #362A15; --drop: #F08A83; --drop-soft: #3A1F1E;
    --s1: #8FA6FF; --s2: #5CC2B8; --s3: #E2B15E; --s4: #C39BEA;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #10141B; --surface: #171C25; --sunk: #1E2430; --ink: #E5E9F0; --muted: #98A2B3; --rule: #2A3242;
  --accent: #8FA6FF; --accent-soft: #232D4A;
  --go: #5CC995; --go-soft: #173327; --later: #E2B15E; --later-soft: #362A15; --drop: #F08A83; --drop-soft: #3A1F1E;
  --s1: #8FA6FF; --s2: #5CC2B8; --s3: #E2B15E; --s4: #C39BEA;
  color-scheme: dark;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body { background: var(--bg); color: var(--ink); font-family: var(--f-body); font-size: 15px; line-height: 1.5; margin: 0; }
.wrap { max-width: 1120px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); padding-block: 28px 64px; display: grid; gap: 36px; }
.wrap > * { min-width: 0; }
h1, h2, h3, h4 { font-family: var(--f-display); text-wrap: balance; margin: 0; letter-spacing: -0.005em; }
h1 { font-size: clamp(30px, 4.4vw, 42px); font-weight: 700; line-height: 1.05; }
h2 { font-size: 22px; font-weight: 600; }
h3 { font-size: 19px; font-weight: 600; line-height: 1.25; }
p { margin: 0; }
a { color: var(--accent); }
code { font-family: var(--f-mono); font-size: 0.88em; background: var(--sunk); padding: 1px 5px; border-radius: 4px; overflow-wrap: anywhere; }
.mono, .num { font-family: var(--f-mono); font-variant-numeric: tabular-nums; }
.muted { color: var(--muted); }
.small { font-size: 13px; }
.eyebrow { font-family: var(--f-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
.lbl { display: block; font-family: var(--f-mono); font-size: 11px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }

/* Header */
header.top { display: grid; gap: 18px; }
.top-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 12px 24px; }
.lede { max-width: 72ch; font-size: 16px; }
.howto { display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 13px; color: var(--muted); }
.howto b { color: var(--ink); font-weight: 600; }

/* Numbers + chart band */
.band { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.55fr); gap: 20px; background: var(--surface); border: 1px solid var(--rule); border-radius: 10px; padding: 20px; }
.band.single { grid-template-columns: minmax(0, 1fr); }
.kpis { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 20px; align-content: start; }
.kpi b { display: block; font-family: var(--f-display); font-size: 34px; font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; }
.kpi span { font-size: 13px; color: var(--muted); }
.kpi .delta { display: block; font-family: var(--f-mono); font-size: 12px; margin-top: 2px; }
.up { color: var(--drop); } .down { color: var(--go); }
.chart { min-width: 0; display: grid; gap: 8px; }
.chart svg { width: 100%; height: auto; display: block; }
.legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 12px; color: var(--muted); }
.legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: -1px; }
.comp { display: grid; gap: 6px; }
.comp-bar { display: flex; height: 12px; border-radius: 6px; overflow: hidden; background: var(--sunk); }
.comp-bar span { display: block; height: 100%; }
@media (max-width: 820px) { .band { grid-template-columns: minmax(0, 1fr); } }

/* Signal */
.signal { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 14px; }
.sig { border-top: 2px solid var(--accent); padding-top: 10px; display: grid; gap: 4px; min-width: 0; }
.sig h4 { font-size: 15px; font-weight: 600; }
.sig p { font-size: 14px; }
.sig .src { font-size: 12px; color: var(--muted); }

/* Section heads + toolbar */
.sec-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 10px 20px; margin-bottom: 14px; }
.sec-head p { max-width: 70ch; color: var(--muted); font-size: 14px; }
.toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; background: var(--bg); padding-block: 10px; border-bottom: 1px solid var(--rule); }
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--bg); }
.filter { display: inline-flex; flex-wrap: wrap; gap: 4px; }
.filter button, .seg button, .btn { font: inherit; font-size: 13px; border: 1px solid var(--rule); background: var(--surface); color: var(--ink); border-radius: 6px; padding: 5px 10px; cursor: pointer; }
.filter button[aria-pressed="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
button:focus-visible, textarea:focus-visible, a:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
#save-status { font-size: 13px; color: var(--muted); }
#tally { font-size: 13px; }
.btn-done { font-weight: 600; border-color: var(--accent); color: var(--accent); }
.btn-done[aria-pressed="true"] { background: var(--accent); color: var(--surface); }
.btn-done[disabled] { cursor: default; opacity: 0.6; }

/* Cards */
.cards { display: grid; gap: 16px; }
.card { background: var(--surface); border: 1px solid var(--rule); border-radius: 10px; display: grid; grid-template-columns: minmax(0, 1fr) 280px; overflow: hidden; }
.card[data-decision="go"] { border-color: var(--go); }
.card[data-decision="later"] { border-color: var(--later); }
.card[data-decision="drop"] { border-color: var(--drop); }
.c-main { padding: 18px 20px; display: grid; gap: 14px; min-width: 0; align-content: start; }
.c-head { display: grid; gap: 6px; }
.c-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font-size: 13px; color: var(--muted); }
.kind { font-family: var(--f-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.08em; padding: 2px 7px; border-radius: 4px; background: var(--sunk); color: var(--ink); }
.kind.epic { background: var(--accent-soft); color: var(--accent); }
.kind.action { background: var(--later-soft); color: var(--later); }
.key { font-family: var(--f-mono); font-weight: 500; overflow-wrap: anywhere; }
.carried { font-family: var(--f-mono); font-size: 11px; letter-spacing: 0.04em; padding: 2px 7px; border-radius: 4px; border: 1px dashed var(--muted); color: var(--muted); }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; border: 1px solid var(--rule); border-radius: 999px; padding: 2px 9px; white-space: nowrap; }
.chip.fit { border-color: var(--go); color: var(--go); }
.chip.rec-kickoff { background: var(--go-soft); border-color: transparent; color: var(--go); font-weight: 600; }
.chip.rec-defer { background: var(--later-soft); border-color: transparent; color: var(--later); font-weight: 600; }
.chip.rec-close { background: var(--drop-soft); border-color: transparent; color: var(--drop); font-weight: 600; }
.chip.risk-low { background: var(--go-soft); border-color: transparent; color: var(--go); }
.chip.risk-medium { background: var(--later-soft); border-color: transparent; color: var(--later); }
.chip.risk-high { background: var(--drop-soft); border-color: transparent; color: var(--drop); }
.summary { font-size: 15px; }
.reasons { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 22px; }
.reasons section { min-width: 0; }
.reasons section.wide { grid-column: 1 / -1; }
.reasons p, .reasons li, .reasons dd { font-size: 14px; }
.reasons ul { margin: 0; padding-left: 18px; display: grid; gap: 3px; }
.reasons ul.pros li::marker { content: "+  "; color: var(--go); font-weight: 600; }
.reasons ul.cons li::marker { content: "−  "; color: var(--drop); font-weight: 600; }
.grid2 { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 4px 12px; margin: 6px 0 0; }
.grid2 dt { color: var(--muted); font-size: 14px; }
.grid2 dd { margin: 0; min-width: 0; }
.tag { font-family: var(--f-mono); font-size: 11px; padding: 1px 6px; border-radius: 4px; background: var(--sunk); color: var(--muted); margin-left: 6px; white-space: nowrap; }
.decisions li::marker { content: "? "; font-family: var(--f-mono); color: var(--later); font-weight: 600; }
.decisions .sugg { display: block; color: var(--muted); }
.decisions .sugg b { color: var(--ink); font-weight: 600; }
.progress { display: grid; gap: 4px; }
.pbar { height: 6px; background: var(--sunk); border-radius: 3px; overflow: hidden; }
.pbar span { display: block; height: 100%; background: var(--accent); }
details.more summary { cursor: pointer; font-size: 13px; color: var(--accent); }
details.more[open] summary { margin-bottom: 8px; }
details.more ul { margin: 0; padding-left: 18px; display: grid; gap: 3px; }
.c-rail { background: var(--sunk); padding: 18px; display: grid; gap: 12px; align-content: start; border-left: 1px solid var(--rule); min-width: 0; }
.seg { display: grid; gap: 6px; }
.seg button { text-align: left; padding: 8px 10px; font-weight: 500; display: flex; justify-content: space-between; align-items: center; gap: 8px; }
.seg button[disabled] { cursor: default; opacity: 0.55; }
.seg button[data-v="go"][aria-pressed="true"] { background: var(--go); border-color: var(--go); color: var(--surface); }
.seg button[data-v="later"][aria-pressed="true"] { background: var(--later); border-color: var(--later); color: var(--surface); }
.seg button[data-v="drop"][aria-pressed="true"] { background: var(--drop); border-color: var(--drop); color: var(--surface); }
.seg button .hint { font-size: 11px; font-family: var(--f-mono); opacity: 0.75; text-align: right; }
.rail-note label { display: block; font-family: var(--f-mono); font-size: 11px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
textarea { width: 100%; font: inherit; font-size: 14px; color: var(--ink); background: var(--surface); border: 1px solid var(--rule); border-radius: 6px; padding: 8px 10px; resize: vertical; min-height: 84px; }
textarea[readonly] { background: var(--sunk); }
.who { font-size: 12px; color: var(--muted); min-height: 1em; }
.result { font-size: 13px; background: var(--surface); border: 1px solid var(--rule); border-radius: 6px; padding: 8px 10px; }
.result a { font-weight: 600; }
@media (max-width: 760px) {
  .card { grid-template-columns: minmax(0, 1fr); }
  .c-rail { border-left: 0; border-top: 1px solid var(--rule); }
  .reasons { grid-template-columns: minmax(0, 1fr); }
}

/* In flight, held, history */
.flight { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 8px 18px; font-size: 14px; }
.flight div { display: flex; gap: 8px; align-items: baseline; min-width: 0; }
.flight .st { font-family: var(--f-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); flex: none; width: 92px; }
.flight .t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.tbl-wrap { overflow-x: auto; max-width: 100%; }
table.hist { border-collapse: collapse; font-size: 14px; min-width: 520px; width: 100%; }
table.hist th, table.hist td { text-align: left; vertical-align: top; padding: 6px 10px; border-bottom: 1px solid var(--rule); }
table.hist th { font-family: var(--f-mono); font-size: 11px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); font-weight: 500; }
table.hist td.k { font-family: var(--f-mono); white-space: nowrap; }
footer { font-size: 13px; color: var(--muted); display: grid; gap: 6px; }
footer ul { margin: 0; padding-left: 18px; }
#empty { padding: 24px; text-align: center; color: var(--muted); }
.gen-box { background: var(--surface); border: 1px solid var(--rule); border-radius: 10px; padding: 16px 18px; display: grid; gap: 8px; }
.gen-box textarea { min-height: 96px; }
@media (prefers-reduced-motion: no-preference) { .card { transition: border-color .15s; } }
</style>

<div class="wrap">
  <header class="top">
    <div class="top-row">
      <div>
        <div class="eyebrow" id="context"></div>
        <h1 id="title">Backlog Brief</h1>
      </div>
      <div class="small muted mono" id="generated"></div>
    </div>
    <p class="lede" id="lede" hidden></p>
    <div class="howto">
      <span><b>Kick off now</b>: Claude starts a Crow workspace (an epic starts its first wave)</span>
      <span><b>Deprioritize</b>: relabelled with a comment, off the brief</span>
      <span><b>Close</b>: closed with a comment, after a last check</span>
      <span><b>Notes</b>: Claude acts on what you write; a note can override its button</span>
      <span><b>Skip a card</b> and it comes back on the next brief</span>
    </div>
  </header>

  <section class="band" id="band" aria-label="Backlog numbers" hidden>
    <div class="kpis" id="kpis"></div>
    <div class="chart" id="chart" hidden>
      <span class="lbl" id="burn-lbl">Open issues</span>
      <div id="burn"></div>
      <div class="legend" id="burn-legend"></div>
      <div class="comp" id="comp"></div>
    </div>
  </section>

  <section aria-labelledby="sig-h" id="sig-sec" hidden>
    <div class="sec-head"><h2 id="sig-h">Signal since the last brief</h2><p>From the org's meetings, Slack, decisions and AI chat. It shapes today's ordering.</p></div>
    <div class="signal" id="signal"></div>
  </section>

  <div class="toolbar">
    <div class="filter" id="filter" role="group" aria-label="Show">
      <button type="button" data-f="all" aria-pressed="true">All</button>
      <button type="button" data-f="undecided" aria-pressed="false">Undecided</button>
      <button type="button" data-f="go" aria-pressed="false">Kick off</button>
      <button type="button" data-f="later" aria-pressed="false">Deprioritize</button>
      <button type="button" data-f="drop" aria-pressed="false">Close</button>
    </div>
    <span id="tally" class="muted">Loading decisions…</span>
    <span id="save-status" role="status" aria-live="polite"></span>
    <button type="button" class="btn btn-done" id="done-btn" aria-pressed="false" disabled>I'm done with this brief</button>
  </div>

  <section aria-labelledby="s-waiting-h" id="s-waiting" hidden>
    <div class="sec-head"><h2 id="s-waiting-h">Waiting on you</h2><p>Work already started that needs your answer, ready-to-merge PRs first. Each card's buttons say what they mean here; put a different answer in the note.</p></div>
    <div class="cards"></div>
  </section>

  <section aria-labelledby="s-kickoff-h" id="s-kickoff" hidden>
    <div class="sec-head"><h2 id="s-kickoff-h">Recommended to kick off</h2><p>Ranked by urgency and value. An epic is decided as a whole; kicking it off starts its first wave as a cascade.</p></div>
    <div class="cards"></div>
  </section>

  <section aria-labelledby="s-watch-h" id="s-watch" hidden>
    <div class="sec-head"><h2 id="s-watch-h">Worth a decision, not urgent</h2><p>Valid work Claude would not start today. Deprioritize keeps it off the next brief; kick it off if you disagree.</p></div>
    <div class="cards"></div>
  </section>

  <section aria-labelledby="s-close-h" id="s-close" hidden>
    <div class="sec-head"><h2 id="s-close-h">Recommended to close</h2><p>Already done, superseded, obsolete or a duplicate, with the evidence on each card. Closing these drains the backlog without engineering time.</p></div>
    <div class="cards"></div>
  </section>

  <p id="empty" hidden>Nothing matches this filter.</p>

  <section aria-labelledby="gen-h" id="gen-sec">
    <div class="sec-head"><h2 id="gen-h">Anything else?</h2><p>Notes for the whole brief: priorities Claude missed, tickets to bring forward, how you want Claude to work.</p></div>
    <div class="gen-box" id="gen-box"></div>
  </section>

  <section aria-labelledby="flight-h" id="flight-sec" hidden>
    <div class="sec-head"><h2 id="flight-h">Already in flight</h2><p>Running in Crow or in review. Not on today's ballot.</p></div>
    <div class="flight" id="flight"></div>
  </section>

  <section aria-labelledby="rev-h" id="rev-sec" hidden>
    <div class="sec-head"><h2 id="rev-h">Also reviewed, holding for now</h2><p>Checked this round and still valid, but lower value or blocked. They come back when something changes; ask for any of them under "Anything else?".</p></div>
    <details class="more"><summary id="rev-sum">Show the list</summary><div class="tbl-wrap"><table class="hist" id="rev"></table></div></details>
  </section>

  <section aria-labelledby="hist-h" id="hist-sec" hidden>
    <div class="sec-head"><h2 id="hist-h">Earlier briefs</h2></div>
    <div class="tbl-wrap"><table class="hist" id="hist"></table></div>
  </section>

  <footer id="method-sec" hidden>
    <span class="lbl">How this brief was made</span>
    <ul id="method"></ul>
  </footer>
</div>

<script type="application/json" id="brief-data">
__BRIEF_DATA__
</script>
<script>
(function () {
  "use strict";
  var SECTIONS = ["waiting", "kickoff", "watch", "close"];
  var DECISION_LABEL = { go: "Kick off now", later: "Deprioritize", drop: "Close ticket" };
  var DECISION_SHORT = { go: "Kick off", later: "Deprioritize", drop: "Close" };
  var DECISION_HINT = { go: "start a workspace", later: "relabel, off the brief", drop: "with a comment" };
  var REC_LABEL = { kickoff: "Recommend: kick off", defer: "Recommend: deprioritize", close: "Recommend: close" };
  var KIND = { epic: "EPIC", ticket: "TICKET", pr: "OPEN PR", decision: "DECISION", action: "HOUSEKEEPING" };
  var NOTE_DEBOUNCE_MS = 800, NOTE_MAX = 4000;

  function $(id) { return document.getElementById(id); }
  function esc(s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]; }); }
  // Inline markup for card text: `code`, **bold**, [text](https://…). Everything else is escaped.
  function md(s) {
    var parts = String(s == null ? "" : s).split("`");
    if (parts.length % 2 === 0) { var tail = parts.pop(); parts[parts.length - 1] += "`" + tail; }
    return parts.map(function (p, i) {
      if (i % 2) return "<code>" + esc(p) + "</code>";
      return esc(p)
        .replace(/\*\*([^*]+)\*\*/g, "<b>$1</b>")
        .replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, "<a href='$2' target='_blank' rel='noopener'>$1</a>");
    }).join("");
  }
  function str(v) { return typeof v === "string" ? v : ""; }
  function arr(v) { return Array.isArray(v) ? v : []; }
  function safeUrl(u) { return typeof u === "string" && /^https?:\/\/\S+$/.test(u) ? u : null; }
  function fmtDay(d) {
    var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(str(d)); if (!m) return str(d);
    try { return new Date(Date.UTC(+m[1], +m[2] - 1, +m[3], 12)).toLocaleDateString(undefined, { month: "short", day: "numeric", timeZone: "UTC" }); } catch (e) { return str(d); }
  }
  function roundName(r) { var m = /^r(\d{4})(\d{2})(\d{2})/.exec(str(r)); return m ? fmtDay(m[1] + "-" + m[2] + "-" + m[3]) : str(r); }

  var D = null;
  try { D = JSON.parse($("brief-data").textContent); } catch (e) { D = null; }
  if (!D || !Array.isArray(D.cards)) { $("tally").textContent = "This page has no brief data. Build it with brief.sh build from the crow-backlog-brief skill."; return; }
  var REL = D.release && typeof D.release === "object" ? D.release : null;

