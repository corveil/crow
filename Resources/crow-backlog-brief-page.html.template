      if (str(w.asked_by)) h += "<dt>Asked by</dt><dd>" + md(w.asked_by) + (typeof w.internal === "boolean" ? "<span class='tag'>" + (w.internal ? "internal" : "external") + "</span>" : "") + "</dd>";
