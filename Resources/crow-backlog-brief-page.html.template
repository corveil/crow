  ITEMS.forEach(function (it) {
    var el = $("i-" + it.id); if (!el) return;
    rows[it.id] = { el: el, btns: Array.prototype.slice.call(el.querySelectorAll(".seg button[data-v]")), who: el.querySelector(".who"), result: el.querySelector(".result"), ta: $("note-" + it.id) };
  });

  // ---- Decisions: collection `decisions`, one doc per card id ----
  // {status: go|later|drop|null, note, by, at, ticket, result}. `ticket` and
  // `result` are written only by Claude. `rounds/<round_id>` holds {done}.
  var server = {}, pending = {}, sent = {}, written = {}, timers = {}, held = {}, retried = {};
  var db = null, user = null, myId = null, canWrite = null, ready = false, names = {}, filter = "all";
  var roundDoc = null, roundBusy = false;

  function writable() { return !!db && ready && canWrite !== false; }
  function view(id) { return Object.assign({}, server[id] || {}, sent[id] || {}, pending[id] || {}); }
  function statusOf(id) { var s = view(id).status; return DECISION_LABEL[s] ? s : ""; }
  function setStatus(t) { $("save-status").textContent = t || ""; }
  function busy() { return Object.keys(sent).length > 0 || Object.keys(pending).length > 0; }

  function whoLine(d, it) {
    var custom = it && it.buttons && it.buttons[d.status] && str(it.buttons[d.status].label);
    var what = custom || DECISION_SHORT[d.status] || (str(d.note) ? "Note" : "");
    if (!what || !d.by) return what && d.status ? what : "";
    var when = "";
    try { if (d.at) when = new Date(d.at).toLocaleString(undefined, { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" }); } catch (e) {}
    return what + " · " + (names[d.by] || "Someone") + (when ? ", " + when : "");
  }

  function paintRow(it) {
    var r = rows[it.id]; if (!r) return;
    var d = view(it.id), st = statusOf(it.id), can = writable();
    r.el.setAttribute("data-decision", st);
    r.btns.forEach(function (b) { b.setAttribute("aria-pressed", String(b.getAttribute("data-v") === st)); b.disabled = !can; });
    r.who.textContent = whoLine(d, it);
    var res = str(d.result), t = safeUrl(d.ticket);
    if (res || t) { r.result.innerHTML = "<span class='lbl'>Claude did</span>" + md(res) + (t ? " <a href='" + esc(t) + "' target='_blank' rel='noopener'>Open ↗</a>" : ""); r.result.hidden = false; }
    else r.result.hidden = true;
    r.ta.readOnly = !can;
