      "<div class='rail-note'><label for='note-" + id + "'>Notes for Claude</label><textarea id='note-" + id + "' maxlength='" + NOTE_MAX + "' placeholder='Scope, owner, caveats, a different plan…' readonly></textarea></div>";
  }
  function list(items, cls) { return "<ul" + (cls ? " class='" + cls + "'" : "") + ">" + items.map(function (q) { return "<li>" + md(q) + "</li>"; }).join("") + "</ul>"; }

  function cardHTML(it) {
