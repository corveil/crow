  var GENERAL = { id: D.round_id + "-general", key: "general", general: true };
  $("gen-box").innerHTML = "<div data-id='" + esc(GENERAL.id) + "' id='i-" + esc(GENERAL.id) + "' style='display:grid;gap:6px'><label class='lbl' for='note-" + esc(GENERAL.id) + "'>Notes for Claude</label><textarea id='note-" + esc(GENERAL.id) + "' maxlength='" + NOTE_MAX + "' placeholder='Bring something forward, hold an area until someone weighs in…' readonly></textarea><div class='who'></div><div class='result' hidden></div></div>";
  var ITEMS = CARDS.concat([GENERAL]);
  var byId = {};
