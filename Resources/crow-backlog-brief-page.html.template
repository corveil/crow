      D.history.map(function (h) { return "<tr><td class='mono'>" + esc(fmtDay(h.round)) + "</td><td>" + md(h.go) + "</td><td>" + md(h.later) + "</td><td>" + md(h.drop) + "</td><td>" + md(h.carried) + "</td><td class='mono'>" + esc(h.open_after) + "</td></tr>"; }).join("") + "</tbody>";
    $("hist-sec").hidden = false;
  }

  // ---- Cards ----
  function timingLabel(t) {
    t = str(t);
    if (t === "before-release") return REL && str(REL.name) ? "Before " + REL.name + (str(REL.date) ? " (" + fmtDay(REL.date) + ")" : "") : "Before the release";
    if (t === "any-time") return "Any time";
