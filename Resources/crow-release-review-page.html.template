<title>__RELEASE_TITLE__</title>
<!--
  /crow-release-review page template (CROW-1371). `release.sh build` fills the
  title and the #release-data block from items.json. Never edit a built page by
  hand: change items.json and build again. Notes, decisions, step results and
  runbook ticks are not in this file; they live in the artifact's db
  collections (notes, decisions, checks, runbook), keyed by the ids in the data.
-->
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Condensed:wght@500;600;700&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap">
<style>
/* Layout: a change-control sheet. Sticky tab bar; a summary, one column of change cards per repo, a runbook and a test ledger. */
:root {
  --bg: #f3f5f8;
  --surface: #ffffff;
  --sunk: #eaeef3;
  --fg: #141922;
  --muted: #586273;
  --line: #d9dee6;
  --accent: #1d5bb0;
  --accent-soft: #e2ecfa;
  --ok: #1d7a48;
  --ok-soft: #dff3e7;
  --warn: #9a6200;
  --warn-soft: #fbefd6;
  --bad: #b42323;
  --bad-soft: #fbe2e0;
  --font-display: "IBM Plex Sans Condensed", "Arial Narrow", system-ui, sans-serif;
  --font-body: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;
  --r: 6px;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --bg: #0e1116; --surface: #161b22; --sunk: #1c222b; --fg: #e5e9ef; --muted: #98a2b1; --line: #2a313c;
  --accent: #74a9ff; --accent-soft: #1b2a42; --ok: #5cc98b; --ok-soft: #14301f; --warn: #e3b04b; --warn-soft: #3a2c0e;
  --bad: #ff7b72; --bad-soft: #3d1715; color-scheme: dark; } }
:root[data-theme="dark"] {
  --bg: #0e1116; --surface: #161b22; --sunk: #1c222b; --fg: #e5e9ef; --muted: #98a2b1; --line: #2a313c;
  --accent: #74a9ff; --accent-soft: #1b2a42; --ok: #5cc98b; --ok-soft: #14301f; --warn: #e3b04b; --warn-soft: #3a2c0e;
  --bad: #ff7b72; --bad-soft: #3d1715; color-scheme: dark; }

* { box-sizing: border-box; }
[hidden] { display: none !important; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--font-body); font-size: 15px; line-height: 1.5; overflow-x: hidden; }
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--surface); }
a { color: var(--accent); overflow-wrap: anywhere; }
code, .mono { font-family: var(--font-mono); font-size: 0.86em; }
h1, h2, h3 { font-family: var(--font-display); text-wrap: balance; margin: 0; letter-spacing: 0.005em; }
h1 { font-size: 1.9rem; font-weight: 700; line-height: 1.15; }
h2 { font-size: 1.35rem; font-weight: 600; }
h3 { font-size: 1.08rem; font-weight: 600; line-height: 1.3; }
p { margin: 0; }
.wrap { max-width: 1080px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
.eyebrow { font-family: var(--font-display); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }

header.top { background: var(--surface); border-bottom: 1px solid var(--line); }
header.top .wrap { padding-block: 22px 14px; display: grid; gap: 14px; }
.versions { display: flex; flex-wrap: wrap; gap: 10px; }
.ver { display: grid; gap: 2px; padding: 8px 12px; border: 1px solid var(--line); border-radius: var(--r); background: var(--bg); min-width: 0; max-width: 100%; }
.ver b { font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; }
.ver span { font-family: var(--font-mono); font-size: 0.8rem; color: var(--muted); overflow-wrap: anywhere; }
.ver .arrow { color: var(--accent); }

nav.tabs { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; background: var(--surface); border-bottom: 1px solid var(--line); }
nav.tabs .wrap { display: flex; gap: 2px; overflow-x: auto; scrollbar-width: none; }
nav.tabs button { font: 600 0.92rem var(--font-display); letter-spacing: 0.02em; color: var(--muted); background: none; border: 0; border-bottom: 3px solid transparent; padding: 11px 12px 9px; cursor: pointer; white-space: nowrap; }
nav.tabs button[aria-selected="true"] { color: var(--fg); border-bottom-color: var(--accent); }
nav.tabs button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
nav.tabs .count { font-family: var(--font-mono); font-weight: 400; font-size: 0.76rem; color: var(--muted); margin-left: 4px; }

main .wrap { padding-block: 22px 60px; display: grid; gap: 22px; }
section[role="tabpanel"] { display: grid; gap: 18px; min-width: 0; }
.lede { max-width: 72ch; color: var(--muted); }

.panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 18px; display: grid; gap: 12px; min-width: 0; }
.verdict { border-left: 5px solid var(--warn); }
.verdict.lvl-low { border-left-color: var(--ok); }
.verdict.lvl-high { border-left-color: var(--bad); }
.verdict p { max-width: 75ch; }
.grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 14px; }
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
.stat { border: 1px solid var(--line); border-radius: var(--r); padding: 10px 12px; background: var(--bg); min-width: 0; }
.stat .n { font-family: var(--font-display); font-size: 1.6rem; font-weight: 700; font-variant-numeric: tabular-nums; }
.stat .l { font-size: 0.82rem; color: var(--muted); }
ul.plain { margin: 0; padding-left: 1.1em; display: grid; gap: 6px; }
ul.plain li { max-width: 80ch; }

.pill { display: inline-flex; align-items: center; gap: 5px; font: 600 0.74rem var(--font-display); letter-spacing: 0.05em; text-transform: uppercase; padding: 2px 8px; border-radius: 999px; white-space: nowrap; border: 1px solid transparent; }
.risk-low { background: var(--ok-soft); color: var(--ok); }
.risk-medium { background: var(--warn-soft); color: var(--warn); }
.risk-high { background: var(--bad-soft); color: var(--bad); }
.pill.cat { background: var(--sunk); color: var(--muted); }
.pill.blk { background: var(--bad); color: var(--surface); }
.pill.open { background: var(--accent-soft); color: var(--accent); }

.callout { border: 1px solid var(--bad); background: var(--bad-soft); border-radius: var(--r); padding: 12px 14px; display: grid; gap: 4px; min-width: 0; }
.callout.soft { border-color: var(--warn); background: var(--warn-soft); }
.callout.calm { border-color: var(--line); background: var(--bg); }
.callout.done { border-color: color-mix(in srgb, var(--ok) 40%, var(--line)); background: var(--ok-soft); }
.callout b { font-family: var(--font-display); font-size: 1rem; }
.callout p { max-width: 80ch; }

.toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.chip { font: 500 0.85rem var(--font-body); border: 1px solid var(--line); background: var(--surface); color: var(--fg); padding: 5px 11px; border-radius: 999px; cursor: pointer; }
.chip[aria-pressed="true"] { background: var(--fg); color: var(--surface); border-color: var(--fg); }
.chip:focus-visible, .btn:focus-visible, textarea:focus-visible, input:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
input[type="search"] { font: inherit; padding: 6px 10px; border: 1px solid var(--line); border-radius: var(--r); background: var(--surface); color: var(--fg); min-width: 0; flex: 1 1 200px; max-width: 320px; }

.items { display: grid; gap: 12px; }
details.item { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); min-width: 0; }
details.item[open] { border-color: color-mix(in srgb, var(--accent) 40%, var(--line)); }
details.item > summary { list-style: none; cursor: pointer; padding: 14px 16px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 14px; align-items: start; }
details.item > summary::-webkit-details-marker { display: none; }
.sum-main { display: grid; gap: 6px; min-width: 0; }
.sum-meta { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; min-width: 0; }
.prn { font-family: var(--font-mono); font-size: 0.8rem; color: var(--muted); }
.sum-side { display: grid; gap: 6px; justify-items: end; text-align: right; }
.progress { font-family: var(--font-mono); font-size: 0.78rem; color: var(--muted); white-space: nowrap; }
.progress.bad { color: var(--bad); }
.dec-badge { font: 600 0.74rem var(--font-display); letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
.dec-badge.ship { color: var(--ok); } .dec-badge.hold { color: var(--bad); } .dec-badge.question { color: var(--warn); }
.fixes { color: var(--muted); font-size: 0.93rem; max-width: 80ch; }
.body { padding: 14px 16px 16px; display: grid; gap: 14px; border-top: 1px solid var(--line); min-width: 0; }
.ba { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 10px; align-items: stretch; }
.ba > div { background: var(--bg); border: 1px solid var(--line); border-radius: var(--r); padding: 10px 12px; min-width: 0; }
.ba .to { color: var(--accent); align-self: center; font-family: var(--font-display); font-weight: 700; }
.ba p { margin-top: 4px; }
.pc { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; }
.pc ul { margin: 4px 0 0; padding-left: 1.1em; display: grid; gap: 3px; }
.lbl { font-family: var(--font-display); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); }
.lbl.good { color: var(--ok); } .lbl.badc { color: var(--bad); }
.riskbox { border-left: 3px solid var(--warn); padding: 2px 0 2px 12px; }
.riskbox.risk-l { border-left-color: var(--ok); } .riskbox.risk-h { border-left-color: var(--bad); }
.riskbox p { margin-top: 4px; max-width: 85ch; }

.steps { display: grid; gap: 6px; min-width: 0; }
.step { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 4px 10px; align-items: start; padding: 9px 10px; border: 1px solid var(--line); border-radius: var(--r); background: var(--bg); min-width: 0; }
.step.pass { background: var(--ok-soft); border-color: color-mix(in srgb, var(--ok) 35%, var(--line)); }
.step.fail { background: var(--bad-soft); border-color: color-mix(in srgb, var(--bad) 45%, var(--line)); }
.step input[type="checkbox"] { width: 18px; height: 18px; margin-top: 2px; accent-color: var(--ok); cursor: pointer; }
.step .st { display: grid; gap: 3px; min-width: 0; }
.step .st b { font-weight: 600; }
.how, .copybox { font-family: var(--font-mono); font-size: 0.8rem; background: var(--surface); border: 1px solid var(--line); border-radius: 4px; padding: 5px 7px; white-space: pre-wrap; overflow-wrap: anywhere; min-width: 0; }
.copybox { background: var(--bg); padding: 10px 12px; border-radius: var(--r); max-height: 320px; overflow: auto; }
.exp, .meta { font-size: 0.88rem; color: var(--muted); }
.ev { font-size: 0.85rem; border-top: 1px dashed var(--line); padding-top: 4px; margin-top: 2px; white-space: pre-wrap; overflow-wrap: anywhere; }
.ev .who { font-family: var(--font-mono); font-size: 0.76rem; color: var(--muted); }
.step .ctl { display: grid; gap: 4px; justify-items: end; }
.needs { font: 500 0.72rem var(--font-mono); color: var(--muted); border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px; white-space: nowrap; }
.needs.person { color: var(--warn); border-color: var(--warn); }
.btn { font: 500 0.82rem var(--font-body); border: 1px solid var(--line); background: var(--surface); color: var(--fg); padding: 3px 9px; border-radius: 4px; cursor: pointer; white-space: nowrap; }
.btn.on-fail { background: var(--bad); color: var(--surface); border-color: var(--bad); }
.btn.primary { background: var(--accent); color: var(--surface); border-color: var(--accent); }
.btn:disabled { opacity: 0.5; cursor: not-allowed; }

.decide { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.decide .btn[aria-pressed="true"].ship { background: var(--ok); color: var(--surface); border-color: var(--ok); }
.decide .btn[aria-pressed="true"].question { background: var(--warn); color: var(--surface); border-color: var(--warn); }
.decide .btn[aria-pressed="true"].hold { background: var(--bad); color: var(--surface); border-color: var(--bad); }
textarea { font: inherit; font-size: 0.93rem; width: 100%; min-height: 76px; resize: vertical; padding: 8px 10px; border: 1px solid var(--line); border-radius: var(--r); background: var(--surface); color: var(--fg); }
textarea:disabled { border-style: dashed; }
.save { font-size: 0.78rem; color: var(--muted); min-height: 1.2em; }
.notes { display: grid; gap: 6px; }

ol.runbook { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; counter-reset: rb; }
ol.runbook li { counter-increment: rb; display: grid; grid-template-columns: 2.2em auto minmax(0, 1fr); gap: 10px; align-items: start; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 11px 12px; min-width: 0; }
ol.runbook li::before { content: counter(rb); font: 700 1.1rem var(--font-display); color: var(--accent); font-variant-numeric: tabular-nums; }
ol.runbook li.done { background: var(--ok-soft); }
ol.runbook li input { width: 18px; height: 18px; margin-top: 3px; accent-color: var(--ok); }
ol.runbook .why { color: var(--muted); font-size: 0.9rem; margin-top: 2px; }
ol.runbook .phase { font: 600 0.72rem var(--font-display); letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); }
.cmd { display: grid; gap: 4px; margin-top: 6px; justify-items: start; min-width: 0; }
.cmd .copybox { max-height: none; width: 100%; }

.ledger-group { display: grid; gap: 8px; min-width: 0; }
.ledger-group h3 { display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
.bar { height: 8px; border-radius: 99px; background: var(--sunk); overflow: hidden; display: flex; }
.bar i { display: block; height: 100%; }
.bar .p { background: var(--ok); } .bar .f { background: var(--bad); }
.status-line { font-size: 0.82rem; color: var(--muted); }
.empty { color: var(--muted); font-style: italic; }
details.method > summary { cursor: pointer; font-family: var(--font-display); font-weight: 600; }

@media (max-width: 680px) {
  h1 { font-size: 1.5rem; }
  details.item > summary { grid-template-columns: minmax(0, 1fr); }
  .sum-side { justify-items: start; text-align: left; grid-auto-flow: column; justify-content: start; align-items: center; }
  .ba { grid-template-columns: minmax(0, 1fr); } .ba .to { justify-self: center; transform: rotate(90deg); }
  .pc { grid-template-columns: minmax(0, 1fr); }
  .step { grid-template-columns: auto minmax(0, 1fr); } .step .ctl { grid-column: 2; justify-items: start; grid-auto-flow: column; justify-content: start; }
  ol.runbook li { grid-template-columns: 1.6em auto minmax(0, 1fr); }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>

<header class="top">
  <div class="wrap">
    <div class="eyebrow" id="hdr-eyebrow">Release review</div>
    <h1 id="hdr-title">Release review</h1>
    <div class="versions" id="versions"></div>
    <div class="status-line" id="db-status" role="status">Loading saved notes and check-offs…</div>
  </div>
</header>
<nav class="tabs" aria-label="Sections"><div class="wrap" role="tablist" id="tablist"></div></nav>
<main><div class="wrap" id="panels"></div></main>

<script type="application/json" id="release-data">
__RELEASE_DATA__
</script>

<script>
(function () {
  "use strict";
  const $ = (sel, el) => (el || document).querySelector(sel);
  let DATA = null;
  try { DATA = JSON.parse($("#release-data").textContent); } catch (e) { DATA = null; }
  if (!DATA || !Array.isArray(DATA.items) || !Array.isArray(DATA.repos)) {
    $("#panels").textContent = "This page has no release data. Build it with release.sh build from the crow-release-review skill.";
    $("#db-status").textContent = "";
    return;
  }

  const arr = (v) => Array.isArray(v) ? v : [];
  const str = (v) => typeof v === "string" ? v : "";
  const safeUrl = (u) => typeof u === "string" && /^https?:\/\/\S+$/.test(u) ? u : null;
  const ITEMS = DATA.items.map(i => Object.assign({}, i, { test_steps: arr(i.test_steps) }));
  const REPOS = DATA.repos;
  const RUNBOOK = arr(DATA.runbook);
  const allSteps = ITEMS.flatMap(i => i.test_steps.map(s => Object.assign({}, s, { item: i })));
  const DECISION_LABEL = { ship: "OK to ship", question: "Question", hold: "Hold" };
  const AGENT_NEEDS = ["agent", "agent+aws"];
  const RISK_RANK = { high: 0, medium: 1, low: 2 };
  const NOTE_MAX = 4000, NOTE_DEBOUNCE_MS = 900;
  const ref = (i) => (str(i.label) || i.repo) + (i.pr != null ? " #" + i.pr : "");
  const itemsOf = (repoId) => ITEMS.filter(i => i.repo === repoId);
  const repoTab = (repoId) => "repo-" + repoId;

  const h = (tag, attrs, ...kids) => {
    const el = document.createElement(tag);
    if (attrs) for (const [k, v] of Object.entries(attrs)) {
      if (v == null || v === false) continue;
      if (k === "class") el.className = v;
      else if (k === "text") el.textContent = v;
      else if (k.startsWith("on")) el.addEventListener(k.slice(2), v);
      else el.setAttribute(k, v === true ? "" : v);
    }
    for (const kid of kids.flat()) if (kid != null && kid !== false) el.append(kid.nodeType ? kid : document.createTextNode(String(kid)));
    return el;
  };
  const link = (url, text) => {
    const u = safeUrl(url);
    return u ? h("a", { href: u, target: "_blank", rel: "noopener", text: text || u.replace(/^https:\/\/github\.com\//, "") }) : null;
  };
  const list = (xs) => h("ul", { class: "plain" }, arr(xs).map(t => h("li", { text: t })));

  // ---------- saved state: the notes, decisions, checks and runbook collections ----------

  const COLS = ["notes", "decisions", "checks", "runbook"];
  const DEFAULTS = {
    notes: { text: "", at: "" },
    decisions: { value: "", at: "" },
    checks: { status: "", note: "", by: "", at: "" },
    runbook: { done: false, at: "" },
  };
  const server = { notes: {}, decisions: {}, checks: {}, runbook: {} };   // from the live snapshots
  const overlay = { notes: {}, decisions: {}, checks: {}, runbook: {} };  // this view's unconfirmed writes
  const loaded = { notes: false, decisions: false, checks: false, runbook: false };
  let db = null, myId = null, canWrite = null;

  const view = (col, id) => Object.assign({}, server[col][id] || {}, overlay[col][id] || {});
  const writable = () => !!db && canWrite !== false && COLS.every(c => loaded[c]);
  const checkOf = (id) => {
    const v = view("checks", id);
    return { status: v.status === "pass" || v.status === "fail" ? v.status : "", note: str(v.note), by: str(v.by) };
  };
  const decisionOf = (id) => { const v = view("decisions", id).value; return DECISION_LABEL[v] ? v : ""; };
  const noteOf = (id) => str(view("notes", id).text);
  const doneOf = (id) => view("runbook", id).done === true;
  function setStatus(t) { const el = $("#db-status"); if (el) el.textContent = t; }

  // One write in flight per document. A newer change to the same document
  // waits and merges into the next write. A new document is created with set;
  // an existing one is merged with update, so fields this view never touched
  // (the evidence note Claude wrote on a check) survive a viewer's tick.
  const queued = new Map(), inflight = new Set();
  function save(col, id, patch, onDone) {
    if (!writable()) { if (onDone) onDone(false); return; }
    overlay[col][id] = Object.assign({}, overlay[col][id] || {}, patch);
    const path = col + "/" + id;
    const q = queued.get(path) || { col, id, patch: {}, cbs: [] };
    Object.assign(q.patch, patch);
    if (onDone) q.cbs.push(onDone);
    queued.set(path, q);
    pump(path);
  }
  function send(col, id, patch) {
    const ref = db.collection(col).doc(id);
    const full = () => Object.assign({}, DEFAULTS[col], server[col][id] || {}, patch);
    if (!server[col][id]) return ref.set(full());
    return ref.update(patch).catch(e => {
      if (e && e.code === "invalid_argument") return ref.set(full());   // deleted meanwhile
      throw e;
    });
  }
  async function pump(path) {
    if (inflight.has(path) || !queued.has(path)) return;
    const q = queued.get(path);
    queued.delete(path);
    if (!writable()) { delete overlay[q.col][q.id]; q.cbs.forEach(cb => cb(false)); scheduleRender(); return; }
    inflight.add(path);
    const patch = Object.assign({}, q.patch, { at: new Date().toISOString() });
    if (myId && (q.col === "checks" || q.col === "runbook")) patch.by = myId;
    let ok = false, err = null;
    try { await send(q.col, q.id, patch); ok = true; }
    catch (e) {
      err = e;
      if (e && e.code === "unavailable") {
        await new Promise(r => setTimeout(r, 400 + Math.random() * 800));
        try { await send(q.col, q.id, patch); ok = true; err = null; } catch (e2) { err = e2; }
      }
    }
    inflight.delete(path);
    if (!queued.has(path)) delete overlay[q.col][q.id];
    if (!ok) failed(err);
    q.cbs.forEach(cb => { try { cb(ok); } catch (_) {} });
    scheduleRender();
    pump(path);
  }
  function failed(e) {
    const code = e && e.code;
