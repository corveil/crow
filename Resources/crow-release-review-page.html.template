    const briefBox = h("div", { class: "copybox", id: "agent-brief", text: brief });
    const copyBtn = h("button", { type: "button", class: "btn primary", onclick: () => copy(brief, briefBox, copyBtn, "Copy agent brief") }, "Copy agent brief");
    p.append(h("div", { class: "panel" }, h("h2", { text: "Post-release test ledger" }),
      h("p", { class: "lede", text: "Every test step from every change, in one list. Tick a step when it passes, or mark it failed. A coding agent can run the steps marked agent and record each result here with its evidence." }),
      h("div", { class: "bar", role: "img", "aria-label": pass + " passed, " + fail + " failed of " + n },
        h("i", { class: "p", style: "width:" + (n ? pass / n * 100 : 0) + "%" }), h("i", { class: "f", style: "width:" + (n ? fail / n * 100 : 0) + "%" })),
      h("p", { class: "status-line", text: pass + " passed · " + fail + " failed · " + (n - pass - fail) + " not run" }),
      h("div", { class: "toolbar" }, h("span", { class: "lbl", text: "Brief for a coding agent" }), copyBtn), briefBox));
    const tb = h("div", { class: "toolbar", role: "group", "aria-label": "Filter steps" });
    for (const [f, label] of [["all", "All"], ["todo", "Not run"], ["pass", "Passed"], ["fail", "Failed"]]) {
      tb.append(h("button", { type: "button", class: "chip", "aria-pressed": String(state.ledgerStatus === f), onclick: () => { state.ledgerStatus = f; render(); } }, label));
    }
    for (const [f, label] of [["all", "Anyone"], ["agent", "An agent can run"], ["person", "Needs a person"]]) {
      tb.append(h("button", { type: "button", class: "chip", "aria-pressed": String(state.ledgerWho === f), onclick: () => { state.ledgerWho = f; render(); } }, label));
    }
    p.append(tb);
    let shown = 0;
    for (const r of REPOS) {
      const steps = allSteps.filter(s => s.item.repo === r.id);
      const visible = steps.filter(ledgerMatches);
      if (!visible.length) continue;
      shown += visible.length;
      const rp = steps.filter(s => checkOf(s.id).status === "pass").length;
      p.append(h("div", { class: "ledger-group" }, h("h3", null, r.name, h("span", { class: "progress", text: rp + "/" + steps.length + " passed" })),
        h("div", { class: "steps" }, visible.map(s => renderStep(s, true)))));
    }
    if (!shown) p.append(h("p", { class: "empty", text: n ? "No steps match this filter." : "This release has no test steps." }));
  }

  // ---------- render ----------

  // A snapshot that lands while someone types a note waits for the blur, so
  // the textarea they're in is never rebuilt under them.
  let deferred = false, frame = 0;
  function render() {
    const active = document.activeElement;
    if (active && active.tagName === "TEXTAREA") { deferred = true; return; }
    deferred = false;
    const y = window.scrollY;
    const qFocus = active && active.id && active.id.startsWith("q-") ? active.id : null;
    renderSummary();
    for (const r of REPOS) renderRepo(r);
    renderRunbook();
    renderTests();
    if (qFocus) { const q = document.getElementById(qFocus); if (q) { q.focus(); q.setSelectionRange(q.value.length, q.value.length); } }
    window.scrollTo({ top: y });
  }
  function scheduleRender() {
    if (frame) return;
    frame = requestAnimationFrame(() => { frame = 0; render(); });
  }

  render();
  selectTab((location.hash || "").replace("#", "") || "summary", true);
  window.addEventListener("hashchange", () => selectTab(location.hash.replace("#", ""), true));

  // ---------- connect to the artifact runtime ----------

  (async function connect() {
    const c = window.claude;
    if (!c || typeof c.use !== "function") { setStatus("Notes and check-offs load when this page is opened on claude.ai."); return; }
    const got = await Promise.all([
      c.use("user").catch(() => null),
      c.use("db").catch(() => null),
    ]);
    const user = got[0];
    if (user) {
      try { myId = await user.id(); } catch (_) { myId = null; }
      try { canWrite = await user.can("data.write"); } catch (_) { canWrite = null; }
    }
    db = got[1];
    if (!db) { setStatus("Saving is unavailable in this view. Open the page on claude.ai, signed in, to see and save notes and check-offs."); return; }
    setStatus(canWrite === false ? "Read-only: you can see notes and results but not change them."
      : "Notes, decisions and check-offs save as you go and are shared with everyone who can open this page.");
    for (const col of COLS) {
      db.collection(col).limit(1000).onSnapshot(snap => {
        const next = {};
        snap.docs.forEach(d => { if (d.exists) { const body = d.data(); if (body && typeof body === "object") next[d.id] = body; } });
        server[col] = next;
        loaded[col] = true;
        scheduleRender();
      }, err => {
        if (err && err.code === "revoked") canWrite = false;
        setStatus("Live updates stopped. Reload to see new results.");
        scheduleRender();
      });
    }
  })();
})();
</script>
